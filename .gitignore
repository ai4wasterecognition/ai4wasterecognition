.claude/

# Raw and local-only data
data/

# Large processed and intermediate outputs
processed/
outputs/
report_assets/
build/
runs/

# Local model checkpoints (regeneratable from training scripts)
models/

# Releases — exclude unknown release subdirs by default, whitelist published ones.
# Using release/* (not release/) so git can still traverse into release/ to
# evaluate the whitelist rules below.
release/*
!release/radar_dataset_v1/
!release/multidetector_dataset_v1/

# Working / report-only CSV exports in the repository root and elsewhere.
# Whitelist only the CSV files that are part of a public release or doc set.
*.csv
!docs/datasets/**/*.csv
!release/**/*.csv
!samples/**/*.csv

# Local office documents and reports
*.docx
*.odt
readme.txt

# Internal planning / utility files that should not be published
PLAN_*.md
prepare_frames_dataset.py
generate_zadanie_docx.py

# Recommended place for public examples
!samples/
!samples/**
