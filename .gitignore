.ipynb_checkpoints/
.jupyter_ystore.db
*.ipynb
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# OS, editor and tool caches
.DS_Store
Thumbs.db
.vscode/
.idea/
